NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info

# PostgreSQL — never commit real credentials
DATABASE_URL=postgres://bizora:bizora@localhost:5432/bizora

# Cloud Run only. Absolute unix socket directory, for example
# /cloudsql/PROJECT:REGION:INSTANCE. Leave unset locally.
# DATABASE_SOCKET_DIR=

# Redis (optional in Sprint 1; required later for jobs)
REDIS_URL=redis://localhost:6379

# Auth — generate a long random secret for every environment
JWT_SECRET=replace-with-a-32-plus-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Public web origin used for CORS when the API is called directly
WEB_ORIGIN=http://localhost:3000

# Session cookie flags (secure defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Development-only: include invite tokens in API responses
INVITE_TOKEN_EXPOSE=false

# Trust X-Forwarded-For (defaults to true when NODE_ENV=production).
# 1 hop for Cloud Run; use 2 hops if a Google external load balancer sits in front.
TRUST_PROXY=false

# Auth / invitation-accept rate limits
THROTTLE_TTL_MS=60000
THROTTLE_AUTH_LIMIT=20

# Google Cloud (deployment only; leave empty locally)
GCP_PROJECT_ID=
GCP_REGION=europe-west1
CLOUD_SQL_CONNECTION_NAME=

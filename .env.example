NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
LOG_LEVEL=info

# PostgreSQL — never commit real credentials
DATABASE_URL=postgres://bizora:bizora@localhost:5432/bizora

# Redis (optional in Sprint 1; required later for jobs)
REDIS_URL=redis://localhost:6379

# Auth — generate a long random secret for every environment
JWT_SECRET=replace-with-a-32-plus-character-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d

# Public web origin used for CORS when the API is called directly
WEB_ORIGIN=http://localhost:3000

# Google Cloud (deployment only; leave empty locally)
GCP_PROJECT_ID=
GCP_REGION=europe-west1
CLOUD_SQL_CONNECTION_NAME=
